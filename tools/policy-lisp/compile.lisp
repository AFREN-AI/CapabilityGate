;;;; Restricted Common Lisp policy-data compiler. It never evaluates policy forms.
(declaim (optimize (safety 3) (debug 2)))

(defun fail (message)
  (error "policy-lisp: ~a" message))

(defun tokenize (source)
  (let ((tokens '()) (index 0) (length (length source)))
    (labels ((emit (value) (push value tokens))
             (spacep (char) (find char '(#\Space #\Tab #\Newline #\Return))))
      (loop while (< index length) for char = (char source index) do
        (cond
          ((spacep char) (incf index))
          ((member char '(#\( #\))) (emit (string char)) (incf index))
          ((char= char #\")
           (incf index)
           (let ((value (make-string-output-stream)))
             (loop
               (when (>= index length) (fail "unterminated string"))
               (let ((current (char source index)))
                 (incf index)
                 (cond
                   ((char= current #\") (return))
                   ((char= current #\\)
                    (when (>= index length) (fail "unfinished string escape"))
                    (let ((escaped (char source index)))
                      (incf index)
                      (case escaped
                        (#\\ (write-char #\\ value))
                        (#\" (write-char #\" value))
                        (#\n (write-char #\Newline value))
                        (#\r (write-char #\Return value))
                        (#\t (write-char #\Tab value))
                        (otherwise (fail "unsupported string escape")))))
                   (otherwise (write-char current value))))
             (emit (list :string (get-output-stream-string value)))))
          (t
           (let ((start index))
             (loop while (and (< index length)
                              (not (spacep (char source index)))
                              (not (member (char source index) '(#\( #\)))))
                   do (incf index))
             (let ((symbol (subseq source start index)))
               (when (or (zerop (length symbol)) (find-if (lambda (c) (find c "#'`,;")) symbol))
                 (fail "reader syntax and comments are not allowed"))
                (emit (string-downcase symbol)))))))
      (coerce (nreverse tokens) 'vector)))))

(defun parse-forms (tokens)
  (let ((index 0) (length (length tokens)))
    (labels ((parse-one ()
               (when (>= index length) (fail "unexpected end of input"))
               (let ((token (aref tokens index)))
                 (incf index)
                 (cond
                   ((equal token "(")
                    (let ((items '()))
                      (loop while (and (< index length) (not (equal (aref tokens index) ")")))
                            do (push (parse-one) items))
                      (when (>= index length) (fail "unclosed form"))
                      (incf index)
                      (nreverse items)))
                   ((equal token ")") (fail "unexpected closing parenthesis"))
                   (t token)))))
      (let ((form (parse-one)))
        (unless (= index length) (fail "only one policy form is allowed"))
        form))))

(defun proper-list-p (value) (and (listp value) (ignore-errors (length value)) t))
(defun head-is (form name) (and (proper-list-p form) form (stringp (first form)) (string= (first form) name)))
(defun string-value (value label)
  (if (and (consp value) (eq (first value) :string) (= (length value) 2))
      (second value)
      (fail (format nil "~a must be a quoted string" label))))
(defun unique-values (values label)
  (unless (= (length values) (length (remove-duplicates values :test #'equal)))
    (fail (format nil "duplicate ~a" label)))
  values)
(defun source-name (symbol)
  (unless (member symbol '("user-intent" "host-policy" "external-content" "derived-value" "quarantined-model-output") :test #'equal)
    (fail (format nil "unknown trust source ~a" symbol)))
  (case (intern (string-upcase symbol) :keyword)
    (:user-intent "UserIntent")
    (:host-policy "HostPolicy")
    (:external-content "ExternalContent")
    (:derived-value "DerivedValue")
    (:quarantined-model-output "QuarantinedModelOutput")))
(defun json-string (value)
  (with-output-to-string (out)
    (write-char #\" out)
    (loop for char across value do
      (case char
        (#\" (write-string "\\\"" out))
        (#\\ (write-string "\\\\" out))
        (#\Newline (write-string "\\n" out))
        (#\Return (write-string "\\r" out))
        (#\Tab (write-string "\\t" out))
        (otherwise
         (if (< (char-code char) 32)
             (format out "\\u~4,'0X" (char-code char))
             (write-char char out)))))
    (write-char #\" out)))
(defun json-array (items)
  (format nil "[~{~a~^,~}]" (mapcar #'json-string items)))

(defun compile-policy (form)
  (unless (head-is form "policy") (fail "root form must be policy"))
  (let* ((forms (rest form))
         (capability-form (find-if (lambda (item) (head-is item "capabilities")) forms))
         (tool-forms (remove-if-not (lambda (item) (head-is item "tool")) forms)))
    (unless capability-form (fail "policy needs one capabilities form"))
    (unless (= (count-if (lambda (item) (head-is item "capabilities")) forms) 1)
      (fail "policy must contain exactly one capabilities form"))
    (unless (= (+ 1 (length tool-forms)) (length forms)) (fail "unknown policy form"))
    (let* ((capabilities (unique-values (mapcar (lambda (x) (string-value x "capability")) (rest capability-form)) "capability"))
           (tools (mapcar (lambda (item) (compile-tool item capabilities)) tool-forms)))
      (unique-values (mapcar #'first tools) "tool")
      (format nil "{~%  \"granted_capabilities\": ~a,~%  \"tools\": [~%~{~a~^,~%~}%  ]~%}~%"
              (json-array capabilities)
              (mapcar (lambda (tool) (concatenate 'string "    " (second tool))) tools)))))

(defun compile-tool (form capabilities)
  (unless (and (head-is form "tool") (>= (length form) 2)) (fail "tool form needs a quoted name"))
  (let* ((name (string-value (second form) "tool name"))
         (forms (cddr form))
         (requires (find-if (lambda (item) (head-is item "requires")) forms))
         (control (find-if (lambda (item) (head-is item "control")) forms))
         (arguments (remove-if-not (lambda (item) (head-is item "argument")) forms)))
    (unless (and requires (= (length requires) 2)) (fail "tool needs exactly one requires form"))
    (unless (and control (>= (length control) 2)) (fail "tool needs exactly one control form"))
    (unless (= (+ 2 (length arguments)) (length forms)) (fail "unknown tool policy form"))
    (unless (= (count-if (lambda (item) (head-is item "requires")) forms) 1) (fail "tool must contain one requires form"))
    (unless (= (count-if (lambda (item) (head-is item "control")) forms) 1) (fail "tool must contain one control form"))
    (let* ((required (string-value (second requires) "required capability"))
           (control-sources (unique-values (mapcar #'source-name (rest control)) "control source"))
           (arg-pairs (mapcar (lambda (argument)
                                (unless (and (>= (length argument) 3)) (fail "argument form needs a name and source list"))
                                (cons (string-value (second argument) "argument name")
                                      (unique-values (mapcar #'source-name (cddr argument)) "argument source"))) arguments))
           (arg-names (mapcar #'car arg-pairs)))
      (unless (member required capabilities :test #'equal) (fail "required capability is not granted"))
      (unique-values arg-names "argument")
      (values (list name
                    (format nil "{\"tool_name\":~a,\"required_capability\":~a,\"allowed_argument_sources\":{~a},\"allowed_control_sources\":~a}"
                            (json-string name) (json-string required)
                            (format nil "~{~a~^,~}" (mapcar (lambda (entry) (format nil "~a:~a" (json-string (car entry)) (json-array (cdr entry)))) arg-pairs))
                            (json-array control-sources)))))))

(defun main ()
  (handler-case
      (let* ((arguments (last sb-ext:*posix-argv*))
             (path (first arguments)))
        (unless path (fail "usage: sbcl --script compile.lisp policy.sexp"))
        (with-open-file (input path :direction :input :external-format :utf-8)
          (let* ((source (with-output-to-string (out) (loop for line = (read-line input nil nil) while line do (write-line line out))))
                 (form (parse-forms (tokenize source))))
            (write-string (compile-policy form)))))
    (error (condition)
      (format *error-output* "~&~a~%" condition)
      (sb-ext:exit :code 2))))

(main)
